# ==========================================
# Configuration Générale
# ==========================================
PORT=5000
NODE_ENV=development
# Liste d'origines autorisées séparées par des virgules en production (ex: https://genmina.vercel.app,https://genmina.org)
CORS_ORIGIN=http://localhost:5173
# Mettre 'none' en production si le frontend et le backend sont sur deux domaines différents (HTTPS requis)
COOKIE_SAMESITE=lax

# ==========================================
# Sécurité & Authentification Administrateur
# Stocké UNIQUEMENT côté serveur (jamais transmis au frontend)
# OBLIGATOIRE en production (NODE_ENV=production)
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GenMina2026!Securite
ADMIN_SESSION_SECRET=cle_secrete_aleatoire_pour_signatures_sessions_2026

# ==========================================
# Stockage Audio : Cloudflare R2
# Si non renseigné, le backend bascule automatiquement sur le stockage local réel (data/uploads)
# ==========================================
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ==========================================
# Base de données : Google Cloud Firestore
# Si non renseigné, le backend bascule automatiquement sur le dépôt JSON persistant (data/*.json)
# ==========================================
FIRESTORE_PROJECT_ID=
# Option 1 (Render / Railway / Cloud) : coller le JSON du compte de service Firebase (brut ou base64)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2 (local / GCP) : chemin vers le fichier JSON
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_COLLECTION_NAME=recordings
FIRESTORE_CONSENTS_COLLECTION=consents
FIRESTORE_PROMPTS_COLLECTION=prompts

# ==========================================
# Adaptateurs Modèles STT / TTS (V2)
# ==========================================
WHISPER_API_KEY=
WHISPER_ENDPOINT_URL=
